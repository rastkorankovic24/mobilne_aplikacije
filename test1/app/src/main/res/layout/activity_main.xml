<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="25dp">

    <CheckBox
        android:id="@+id/cbStopAudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zaustavi snimanje" />

    <CheckBox
        android:id="@+id/cbFetchCountries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Države (API / Baza)" />

    <Button
        android:id="@+id/btnSnimi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Snimi" />

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lokacija: Traženje..."
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvProximity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Proximity senzor: --"
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

</LinearLayout>